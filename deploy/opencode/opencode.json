{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "not-needed-loopback"
      },
      "models": {
        "local-moe": {
          "name": "local-moe"
        }
      }
    }
  },
  "model": "local/local-moe",
  "mcp": {
    "rtmx": {
      "type": "local",
      "enabled": true,
      "command": ["rtmx", "mcp-server", "--stdio"]
    }
  }
}
