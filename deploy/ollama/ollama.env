# deploy/ollama — spike serving environment (localhost-bound, no phone-home).
#
# Source this (or set in the unit/launchd env) before starting `ollama serve` for
# the fast-iteration spike. Production serving is llama.cpp (deploy/llama-server).
#
# Air-gap posture: bound to loopback, update checks OFF, no telemetry.

# Bind the API to loopback only — never 0.0.0.0 (would expose off-box).
OLLAMA_HOST=127.0.0.1:11434

# Disable the automatic update check (an egress vector — GUARD gate).
OLLAMA_NOPRUNE=1
OLLAMA_NOHISTORY=1
# Ollama checks for updates on launch; pinning the version and blocking egress at
# the firewall (deploy/firewall) is the durable control. Keep the host offline.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m
