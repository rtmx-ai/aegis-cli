#!/usr/bin/env bash
# aegis-cli pre-commit hook
# Mirrors CI pipeline gates: format, lint, unit tests
# Prevents quality escapes from the local environment.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

fail() { echo -e "${RED}FAILED:${NC} $1"; exit 1; }
pass() { echo -e "${GREEN}PASSED:${NC} $1"; }
warn() { echo -e "${YELLOW}WARN:${NC} $1"; }

echo "=== aegis pre-commit checks ==="

# 1. Format check (matches CI: cargo fmt --check --all)
echo -n "Checking format... "
cargo fmt --check --all 2>/dev/null || fail "cargo fmt --check --all
  Run 'cargo fmt --all' to fix formatting."
pass "cargo fmt"

# 2. Clippy lint (matches CI: cargo clippy --workspace --all-targets with -D warnings)
echo -n "Checking clippy... "
RUSTFLAGS="-D warnings" cargo clippy --workspace --all-targets 2>/dev/null || fail "cargo clippy --workspace --all-targets
  Fix all clippy warnings before committing."
pass "cargo clippy"

# 3. Unit tests (matches CI: cargo nextest run --lib --workspace, falls back to cargo test)
echo -n "Running unit tests... "
if command -v cargo-nextest &>/dev/null; then
    cargo nextest run --lib --workspace 2>/dev/null || fail "cargo nextest run --lib --workspace"
else
    cargo test --lib --workspace 2>/dev/null || fail "cargo test --lib --workspace"
fi
pass "unit tests"

# 4. Doc tests (matches CI: cargo test --doc --workspace)
echo -n "Running doc tests... "
cargo test --doc --workspace 2>/dev/null || fail "cargo test --doc --workspace"
pass "doc tests"

echo -e "${GREEN}All pre-commit checks passed.${NC}"
